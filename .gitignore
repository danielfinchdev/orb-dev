# Dependencias y compilados
node_modules/
dist/

# Bitácora privada del proyecto (nunca se sube)
BITACORA.md

# Secretos que nunca deben entrar en git
.env
.env.*
!.env.example
*.pem
*.key
# The updater's TEST key (password «prueba»): only the test build trusts it (scripts/tauri-check-release.mjs).
!test/fixtures/actualizador-prueba.key

# Carpetas de pruebas locales
.orb-prueba/
test-results/

# Interfaz compilada (npm run build la genera desde src/ui)
src/renderer/
src/renderer-android/

# App Android (npm run android:build): la interfaz (src/renderer-android), lo compilado (src-tauri/gen/android tiene sus
# propios .gitignore), la imagen de los avisos copiada en cada compilación y las claves (van en orb-build-cache\keys)
src-tauri/gen/android/app/src/main/res/drawable-nodpi/av_*.png
*.jks
*.keystore
*.apk
*.aab

# Clave de firma de las versiones de Orb Server (vive fuera del repo, en %USERPROFILE%\.orb-release)
.orb-release/
release.key

# Tauri (src-tauri): compiled code, and the engine and Node copied for the package (scripts/tauri-resources.mjs)
src-tauri/target/
src-tauri/target-e2e/
src-tauri/resources/
src-tauri/gen/schemas/
src-tauri/permissions/autogenerated/
