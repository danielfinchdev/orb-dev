# Dependencias y compilados
node_modules/
dist/

# Bitácora privada del proyecto (nunca se sube)
BITACORA.md

# Secretos que nunca deben entrar en git
.env
.env.*
!.env.example
*.pem
*.key

# Carpetas de pruebas locales
.orb-prueba/
test-results/

# Interfaz compilada (npm run build la genera desde src/ui)
src/renderer/

# App Android (npm run android:build): la interfaz copiada, lo compilado y las claves (van en %LOCALAPPDATA%\orb-build-cache)
android-app/www/
android-app/android/.gradle/
android-app/android/app/build/
android-app/android/build/
android-app/android/app/src/main/res/drawable-nodpi/av_*.png
*.jks
*.keystore
*.apk
*.aab

# Clave de firma de las versiones de Orb Server (vive fuera del repo, en %USERPROFILE%\.orb-release)
.orb-release/
release.key

# Tauri (src-tauri): compiled code, and the engine and Node copied for the package (scripts/tauri-resources.mjs)
src-tauri/target/
src-tauri/target-e2e/
src-tauri/resources/
src-tauri/gen/schemas/
src-tauri/permissions/autogenerated/
