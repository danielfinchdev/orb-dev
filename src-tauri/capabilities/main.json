{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Orb's window: the engine bridge, the window's own controls and the engine's events. Nothing else (no file system, shell or dialog permissions: Rust does those after its own checks).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-engine-call",
    "allow-app-info",
    "allow-app-retry-start",
    "allow-app-delete-project",
    "allow-app-setup",
    "allow-app-switch-home",
    "allow-app-zoom",
    "allow-app-zoom-step",
    "allow-window-act",
    "allow-window-drag",
    "allow-app-pick-folder",
    "allow-app-pick-program",
    "allow-app-pick-files",
    "allow-app-pick-images",
    "allow-app-feedback-images",
    "allow-app-feedback-capture",
    "allow-app-open-path",
    "allow-app-open-external",
    "allow-app-show-browser",
    "allow-app-update",
    "allow-app-update-check",
    "allow-app-update-download",
    "allow-app-update-install"
  ]
}
