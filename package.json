{
  "name": "orb-dev",
  "productName": "Orb",
  "version": "3.8.1",
  "description": "Orb: one app for your AI coding agents (Claude Code, Codex, Cursor, Gemini, OpenCode, Qwen, Copilot). Its assistant plans the work, writes a clear brief for each agent and brings back checked results.",
  "private": true,
  "type": "module",
  "author": "Orb",
  "homepage": "https://github.com/danielfinchdev/orb-dev",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "start": "tauri dev",
    "start:control": "vite build && node scripts/start-control.mjs",
    "check": "node scripts/check.mjs",
    "test": "vite build --logLevel warn && node scripts/vault-build.mjs && node --test test/*.test.mjs",
    "vault": "node scripts/vault-build.mjs",
    "test:app": "node test/app.e2e.mjs",
    "icon": "node scripts/icono.mjs",
    "test:movil": "vite build && node test/mobile.e2e.mjs",
    "test:android-app": "node test/android-app.e2e.mjs",
    "test:glass": "node test/glass.e2e.mjs",
    "test:tauri-navegador": "node test/tauri-navegador.e2e.mjs",
    "test:tauri-actualizar": "node test/tauri-actualizar.e2e.mjs",
    "test:puente-electron": "node test/puente-electron.e2e.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build -- --locked && node scripts/tauri-check-release.mjs",
    "tauri:build:e2e": "node scripts/tauri-check-release.mjs --build-e2e",
    "release:firmar": "node scripts/release-firmar.mjs",
    "android:build": "node scripts/android-build.mjs",
    "android:build:debug": "node scripts/android-build.mjs --debug"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "~11.11.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.52.0",
    "playwright-core": "1.63.0",
    "pngjs": "^5.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "zod": "^4.6.5"
  }
}
