{
  "name": "orb-dev",
  "productName": "Orb",
  "version": "2.5.0",
  "description": "Orb·e: tu director de bolsillo. Planifica tu proyecto por fases y escribe un encargo claro para cada agente (Claude Code, Codex, Cursor, Gemini, OpenCode, Qwen, Copilot), sin gastar tokens de más. Te entrega resultados comprobados.",
  "private": true,
  "type": "module",
  "main": "src/main/main.mjs",
  "author": "Orb",
  "license": "UNLICENSED",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "check": "node scripts/check.mjs",
    "test": "vite build --logLevel warn && node --test test/*.test.mjs",
    "test:app": "vite build && node test/app.e2e.mjs",
    "icon": "node scripts/icono.mjs",
    "dist": "vite build && electron-builder --win portable nsis",
    "test:movil": "vite build && node test/mobile.e2e.mjs",
    "icon:ico": "electron scripts/icono-ico.cjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "highlight.js": "~11.11.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.52.0",
    "playwright-core": "1.63.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.2"
  },
  "build": {
    "appId": "dev.orb.app",
    "productName": "Orb",
    "copyright": "Orb",
    "publish": [
      {
        "provider": "github",
        "owner": "danielfinchdev",
        "repo": "orb-dev"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/ui/**",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!node_modules/@anthropic-ai/sdk/**",
      "!node_modules/@modelcontextprotocol/**",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.map",
      "!node_modules/**/README*",
      "!node_modules/**/CHANGELOG*"
    ],
    "asarUnpack": [
      "src/**",
      "node_modules/@anthropic-ai/claude-agent-sdk/**",
      "node_modules/zod/**",
      "node_modules/@noble/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "Orb-${version}-windows.${ext}",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "Orb-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Orb-${version}-instalador.exe"
    },
    "electronFuses": {
      "runAsNode": true,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "linux": {
      "executableName": "orb-dev"
    }
  },
  "allowScripts": {
    "electron@44.5.1": true
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "electron-updater": "6.8.10",
    "zod": "^4.6.5"
  }
}
