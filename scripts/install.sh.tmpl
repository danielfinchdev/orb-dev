#!/bin/sh
# Orb Server @@VERSION@@: one command installs it on a Linux server (x64 or arm64) for the current user.
#   bash install.sh [--pair <code>@<app-address>#<app-key-fp>] [--no-sudo] [--tarball <file>]
# What it does, in order:
#   1. downloads this version's package from the official GitHub release (or uses --tarball) and checks its SHA-256,
#      and the SHA-256 of the Node inside it, against the sums written here when the release was made (signed with the
#      release key: install.sh.sig);
#   2. unpacks it in ~/orb-server/app/@@VERSION@@ and points ~/orb-server/app/current to it;
#   3. moves an install from before 3.7 (~/orb, ~/orb-nucleo) to ~/orb-server, keeping the data and the links, after a
#      backup;
#   4. installs the systemd user service orb-server.service (starts at boot, restarts when it falls) and turns off the
#      old one;
#   5. asks for sudo ONCE (unless --no-sudo): linger (on without a session open) and the admin helper with its sudoers
#      drop-in (a fixed list of server actions, each one approved on a card in Orb);
#   6. pairs with the Orb app that gave the command (--pair), or prints a short code to type in the app.
# Generated from scripts/install.sh.tmpl by `npm run dist:server`. Nothing is sent anywhere but the app you pair with.
set -eu

VERSION='@@VERSION@@'
SHA256_X64='@@SHA256_X64@@'
SHA256_ARM64='@@SHA256_ARM64@@'
NODE_SHA256_X64='@@NODE_SHA256_X64@@'
NODE_SHA256_ARM64='@@NODE_SHA256_ARM64@@'
RELEASE="${ORB_RELEASE_URL:-https://github.com/danielfinchdev/orb-dev/releases/download/v$VERSION}"
BASE="$HOME/orb-server"
APP="$BASE/app"

PAIR=''
SUDO=1
TARBALL=''
while [ "$#" -gt 0 ]; do
  case "$1" in
    --pair) PAIR="${2:-}"; shift 2 ;;
    --pair=*) PAIR="${1#--pair=}"; shift ;;
    --no-sudo) SUDO=''; shift ;;
    --tarball) TARBALL="${2:-}"; shift 2 ;;
    -h|--help) sed -n '2,3p' "$0"; exit 0 ;;
    *) echo "No entiendo «$1» (prueba --help)" >&2; exit 64 ;;
  esac
done

say() { printf '%s\n' "$*"; }
fail() { printf 'Orb Server: %s\n' "$*" >&2; exit 1; }

[ "$(uname -s)" = Linux ] || fail "solo funciona en Linux"
[ "$(id -u)" != 0 ] || fail "instálalo con tu usuario, no como root"
case "$(uname -m)" in
  x86_64|amd64) ARCH=x64; SUM=$SHA256_X64; NODE_SUM=$NODE_SHA256_X64 ;;
  aarch64|arm64) ARCH=arm64; SUM=$SHA256_ARM64; NODE_SUM=$NODE_SHA256_ARM64 ;;
  *) fail "procesador no compatible: $(uname -m) (x64 o arm64)" ;;
esac
[ -n "$SUM" ] || fail "este instalador no trae la suma del paquete para $ARCH"
command -v sha256sum >/dev/null 2>&1 || fail "falta sha256sum (coreutils)"
command -v systemctl >/dev/null 2>&1 || fail "hace falta systemd"
case "$PAIR" in ''|*[!A-Za-z0-9@#:._/-]*) [ -z "$PAIR" ] || fail "el emparejado va así: <código>@<dirección>#<huella>" ;; esac

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
NAME="orb-server-$VERSION-linux-$ARCH.tar.gz"

say "1/6 Paquete de Orb Server $VERSION para linux-$ARCH"
if [ -n "$TARBALL" ]; then cp "$TARBALL" "$TMP/$NAME"
else curl -fsSL --proto '=https' --tlsv1.2 "$RELEASE/$NAME" -o "$TMP/$NAME" || fail "no se pudo descargar $NAME"; fi
echo "$SUM  $TMP/$NAME" | sha256sum -c --quiet - || fail "la suma SHA-256 del paquete no coincide: no se instala"

say "2/6 Descomprimiendo en $APP/$VERSION"
mkdir -p "$APP"
# Orb Server's data are for this user only.
chmod 700 "$BASE"
rm -rf "$APP/.nuevo" && mkdir -p "$APP/.nuevo"
tar -xzf "$TMP/$NAME" -C "$APP/.nuevo"
echo "$NODE_SUM  $APP/.nuevo/orb-server-$VERSION/node/bin/node" | sha256sum -c --quiet - || { rm -rf "$APP/.nuevo"; fail "la suma SHA-256 de Node no coincide: no se instala"; }
"$APP/.nuevo/orb-server-$VERSION/node/bin/node" --version >/dev/null || { rm -rf "$APP/.nuevo"; fail "el Node del paquete no arranca en este sistema"; }
rm -rf "$APP/$VERSION"
mv "$APP/.nuevo/orb-server-$VERSION" "$APP/$VERSION"
rmdir "$APP/.nuevo"
NEW="$APP/$VERSION"

say "3/6 Parando la versión anterior y moviendo sus datos (con una copia antes)"
systemctl --user stop orb-server.service 2>/dev/null || true
systemctl --user stop orb-nucleo.service 2>/dev/null || true
ORB_HOME="$BASE" "$NEW/orb-server" migrar
ln -sfn "$VERSION" "$APP/current.nuevo" && mv -Tf "$APP/current.nuevo" "$APP/current"
rm -f "$APP/update-from" "$APP/update-tries" "$APP/update-pending.json"
mkdir -p "$HOME/.local/bin"
ln -sfn "$APP/current/orb-server" "$HOME/.local/bin/orb-server"
# The old command keeps working (hidden) for one minor version.
ln -sfn "$APP/current/orb-nucleo" "$HOME/.local/bin/orb-nucleo"

say "4/6 Servicio orb-server (systemd de tu usuario)"
UNIT_DIR="$HOME/.config/systemd/user"
mkdir -p "$UNIT_DIR"
if [ -n "$SUDO" ]; then cp "$APP/current/orb-server.service" "$UNIT_DIR/orb-server.service"
else cp "$APP/current/orb-server-nosudo.service" "$UNIT_DIR/orb-server.service"; fi
systemctl --user disable orb-nucleo.service 2>/dev/null || true
rm -f "$UNIT_DIR/orb-nucleo.service" "$UNIT_DIR/default.target.wants/orb-nucleo.service"
systemctl --user daemon-reload

ADMIN=no
if [ -n "$SUDO" ]; then
  say "5/6 Una sola vez con sudo: encendido al arrancar el servidor y las acciones de administración aprobadas"
  # Over SSH there is no terminal for the password: sudo -n never waits for one (it fails instead).
  if [ -t 0 ]; then ASK=sudo; else ASK='sudo -n'; fi
  if [ -t 0 ] || sudo -n true 2>/dev/null; then
    if $ASK sh "$APP/current/admin-setup.sh" "$(id -un)" "$NEW" | grep -q '^ADMIN=si$'; then ADMIN=si; fi
  else
    say "   (sin terminal para la contraseña) Hazlo luego una vez: sudo sh $APP/current/admin-setup.sh $(id -un) $NEW"
  fi
else
  say "5/6 Sin sudo: Orb Server funcionará mientras tengas la sesión abierta y no hará acciones de administración."
fi
systemctl --user enable --now orb-server.service
sleep 3
STATE=$(systemctl --user is-active orb-server.service || true)
[ "$STATE" = active ] || fail "el servicio no ha arrancado: journalctl --user -u orb-server -n 50"

say "6/6 Enlazar con tu Orb"
if [ -n "$PAIR" ]; then "$APP/current/orb-server" emparejar "$PAIR" || true
else "$APP/current/orb-server" enlazar --tipo orb --admin --no-esperar || true; fi

say ""
say "Listo: Orb Server $VERSION está en marcha y arranca solo con el servidor."
[ "$ADMIN" = si ] || say "Sin acciones de administración (instalado sin sudo)."
say "Tus datos: $BASE · Estado: systemctl --user status orb-server · Desinstalar: mira docs/SERVER.md"
# For the installer by SSH (scripts/instalar-servidor.mjs).
echo "SERVICIO=$STATE"
echo "ADMIN=$ADMIN"
